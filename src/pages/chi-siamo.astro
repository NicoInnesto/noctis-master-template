---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import room from "../assets/images/room.jpg";
import chef from "../assets/images/chef.jpg";
import rose from "../assets/images/rose-room.jpg";
---
<BaseLayout title="Chi siamo" description="La filosofia di Noctis: un rifugio urbano immaginario dove cucina, miscelazione e ospitalità invitano a rallentare.">
  <PageHero eyebrow="La nostra storia" title="L'essenza della notte" intro="Uno spazio per fermarsi, guardare meglio e sentire di più." image={room} imageAlt="Sala elegante con lampade calde" position="center 53%" />
  <section class="editorial-split container">
    <div class="section-kicker"><span>01</span><span>Filosofia</span></div>
    <div><h2>Un rifugio urbano<br /><em>fuori dal rumore.</em></h2><p>Noctis nasce dall'idea che il tempo e la cura del dettaglio siano le forme più autentiche di lusso. L'atmosfera scura e avvolgente lascia spazio alla conversazione, al piatto, al bicchiere.</p><p>La nostra cucina immaginaria parte dalla tradizione emiliana e guarda al mondo. Tecnica e intuizione si incontrano, lasciando la materia prima al centro.</p></div>
  </section>
  <section class="image-story container">
    <div class="image-story-photo"><Image src={chef} width={1200} alt="Chef al lavoro in cucina" loading="lazy" /></div>
    <div class="image-story-copy"><p class="eyebrow">02 / La cucina</p><h2>Ogni gesto<br /><em>ha un'intenzione.</em></h2><p>Piatti essenziali nell'idea, sorprendenti nell'esecuzione. Il menu suggerisce un viaggio, ma lascia a ciascuno il piacere di scegliere il proprio percorso.</p><a class="text-link" href="/menu/">Entra in cucina <span aria-hidden="true">↗</span></a></div>
  </section>
  <section class="wide-image"><Image src={rose} width={1920} alt="Tavolo con una rosa in un ambiente raccolto" loading="lazy" /></section>
  <section class="center-cta container"><p class="eyebrow">Ti aspettiamo, idealmente</p><h2>Il tuo posto nella notte.</h2><p>Esplora l'esperienza dimostrativa di prenotazione.</p><a class="button-primary" href="/prenota/">Scopri le prenotazioni <span aria-hidden="true">↗</span></a></section>
</BaseLayout>
