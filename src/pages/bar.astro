---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import MenuCatalog from "../components/MenuCatalog.astro";
import { barMenu } from "../data/menu";
import image from "../assets/images/cocktail.jpg";
---
<BaseLayout title="Il bar" description="Alchimia liquida a Noctis: cocktail d'autore e una selezione pensata per accompagnare la serata.">
  <PageHero eyebrow="Alchimia liquida" title="Il bar" intro="Un altro modo di raccontare la notte, un sorso alla volta." image={image} imageAlt="Cocktail in coppa servito al bancone" position="center 55%" />
  <MenuCatalog
    categories={barMenu}
    eyebrow="Esplora il bar"
    navigationLabel="Categorie del bar"
    asideNote="Cocktail e vini di questa selezione sono parte del concept dimostrativo Noctis."
    closingText="Un aperitivo che diventa cena, una cena che diventa notte."
    closingLink="Prenota la tua serata"
  />
</BaseLayout>
