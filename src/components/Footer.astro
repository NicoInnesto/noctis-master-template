---
import { withBase } from "../config/paths";
import { site } from "../config/site";
import SocialLinks from "./SocialLinks.astro";
---
<footer class="site-footer">
  <div class="footer-top">
    <div>
      <p class="eyebrow">La serata comincia qui</p>
      <p class="footer-statement">Ci vediamo<br /><em>dopo il tramonto.</em></p>
    </div>
    <a class="circle-link" href={withBase("/prenota/")} aria-label="Vai alle prenotazioni">Prenota</a>
  </div>
  <div class="footer-bottom">
    <a class="footer-logo" href={withBase("/")}>NOCTIS<span>✦</span></a>
    <div class="footer-meta"><SocialLinks /><p>{site.isDemo ? "Concept dimostrativo · Ristorante immaginario" : site.displayAddress}<br />© {new Date().getFullYear()} {site.label} · <a href={withBase("/privacy/")}>Privacy</a></p></div>
  </div>
</footer>
