---
import { site } from "../config/site";
---
<div class="social-links" aria-label="Social dimostrativi">
  {site.social.map((item) => <a href={item.href} data-social-placeholder aria-label={`${item.label} (collegamento dimostrativo)`} title={`${item.label} · presto online`}>
    {item.label === "Instagram" ?
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.6" r=".9" fill="currentColor" stroke="none" /></svg>
      : <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.8 21v-8.1h2.8l.4-3.2h-3.2V7.6c0-.9.3-1.5 1.6-1.5H17V3.2c-.3 0-1.2-.2-2.3-.2-2.4 0-4 1.5-4 4.2v2.5H8v3.2h2.7V21h3.1Z" /></svg>}
  </a>)}
</div>
<script>
  document.addEventListener("click", (event) => {
    if ((event.target as Element).closest("[data-social-placeholder]")) event.preventDefault();
  });
</script>
