---
import { withBase } from "../config/paths";
import MenuList from "./MenuList.astro";
import MenuCategoryIcon from "./MenuCategoryIcon.astro";
import type { MenuCategory } from "../data/menu";

interface Props {
  categories: MenuCategory[];
  eyebrow: string;
  navigationLabel: string;
  asideNote: string;
  closingText: string;
  closingLink: string;
}

const { categories, eyebrow, navigationLabel, asideNote, closingText, closingLink } = Astro.props;
const mobileLabels: Record<string, string> = {
  antipasti: "Per iniziare", primi: "La terra", secondi: "Secondi", dessert: "Dessert",
  "signature-cocktails": "Signature", classici: "Classici", vini: "Vini", "zero-alcol": "Zero alcol",
};
---
<div class="menu-layout container" data-menu-catalog>
  <aside class="menu-aside">
    <p class="eyebrow">{eyebrow}</p>
    <nav aria-label={navigationLabel}>
      {categories.map((category) => <a href={`#${category.id}`}>{category.title}</a>)}
    </nav>
    <div class="menu-mobile-tabs" role="group" aria-label={navigationLabel}>
      {categories.map((category) => <button type="button" class="menu-mobile-tab" data-menu-tab={category.id} aria-controls={category.id} aria-pressed="false" aria-label={category.title}>
        <span class="menu-mobile-tab-icon"><MenuCategoryIcon category={category.id} /></span>
        <span class="menu-mobile-tab-label" aria-hidden="true">{mobileLabels[category.id] ?? category.title}</span>
      </button>)}
    </div>
    <p class="aside-note">{asideNote}</p>
  </aside>
  <div class="menu-main">
    {categories.map((category, index) => <section class="menu-category" id={category.id} aria-labelledby={`title-${category.id}`}>
      <div class="menu-category-head">
        <span>{String(index + 1).padStart(2, "0")} / {String(categories.length).padStart(2, "0")}</span>
        <h2 id={`title-${category.id}`}>{category.title}</h2>
        <p>{category.intro}</p>
      </div>
      <MenuList items={category.items} />
    </section>)}
    <div class="menu-end"><p>{closingText}</p><a class="text-link" href={withBase("/prenota/")}>{closingLink}</a></div>
  </div>
</div>
<script>import "../scripts/menu-reveal";</script>
