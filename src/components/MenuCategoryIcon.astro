  {category === "primi" && <><path d="M9 31c5-5 10-7 15-7s10 2 15 7M12 34h24M16 20c0-4 3-5 3-9M24 20c0-4 3-5 3-9M32 20c0-4 3-5 3-9" /></>}
  {category === "secondi" && <><path d="M7 32h34M11 29c0-9 5-15 13-15s13 6 13 15M21 11a3 3 0 0 1 6 0" /></>}
  {category === "dessert" && <><path d="M11 23h26l-3 14H14l-3-14ZM15 23c-3-6 1-11 6-8 1-5 8-5 9 0 5-2 9 3 6 8M24 10v4" /></>}
  {category === "signature-cocktails" && <><path d="M9 12h30L24 28 9 12ZM24 28v9M16 37h16M31 10l5-5" /><circle cx="31" cy="17" r="2" /></>}
